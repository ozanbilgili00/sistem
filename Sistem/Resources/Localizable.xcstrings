    "Yüzde, durum ve kalan süre sistem bildirimiyle gelir; sürekli okunmaz. Elektrik değerleri 30 saniyede bir yenilenir." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Percentage, state and time remaining arrive through system notifications and are not polled. Electrical values refresh every 30 seconds."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yüzde, durum ve kalan süre sistem bildirimiyle gelir; sürekli okunmaz. Elektrik değerleri 30 saniyede bir yenilenir."
          }
        }
      }
