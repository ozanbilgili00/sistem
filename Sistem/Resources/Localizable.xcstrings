      }
    },
    "Neden uyanık?" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Why awake?"
          }
        }
      }
    },
    "Pil yüzde 15 ve altında: uyanık tutma durduruldu." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Battery at 15 % or lower: keeping awake was stopped."
