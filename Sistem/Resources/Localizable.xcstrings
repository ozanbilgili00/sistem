    "CPU": {
      "shouldTranslate": false
    },
    "CPU, RAM ve GPU yüzde, sıcaklık derece olarak burada görünecek. Canlı veriler Faz 2'de geliyor.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "CPU, RAM and GPU as percentages and temperature in degrees will show here. Live data arrives in phase 2."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "CPU, RAM ve GPU yüzde, sıcaklık derece olarak burada görünecek. Canlı veriler Faz 2'de geliyor."
          }
        }
      }
    },
    "CPU, RAM ve GPU yüzde, sıcaklık derece olarak gösterilir. Sıralama ve seçim Faz 2'de düzenlenebilir olacak.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "CPU, RAM and GPU show as percentages, temperature in degrees. Order and selection become editable in phase 2."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "CPU, RAM ve GPU yüzde, sıcaklık derece olarak gösterilir. Sıralama ve seçim Faz 2'de düzenlenebilir olacak."
