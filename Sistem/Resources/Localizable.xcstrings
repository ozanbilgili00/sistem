    },
    "Bu sayfa açıkken ölçüm saniyede bir yapılır ve değerler sayfanın kendi maliyetini de içerir. Gerçek boşta tüketim için `scripts/perf-check.sh` kullanılır.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "While this page is open it samples once a second, so the values include the page's own cost. Use `scripts/perf-check.sh` for true idle usage."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu sayfa açıkken ölçüm saniyede bir yapılır ve değerler sayfanın kendi maliyetini de içerir. Gerçek boşta tüketim için `scripts/perf-check.sh` kullanılır."
          }
        }
      }
    },
