          "stringUnit" : {
            "state" : "translated",
            "value" : "If left empty, the system time style is used. Examples: HH:mm, EEE HH:mm, d MMM HH:mm. A format with seconds redraws the menu bar item every second."
          }
        },
        "tr" : {
          "stringUnit" : {
