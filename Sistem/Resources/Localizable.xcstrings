    "Simgeye tıklayınca" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clicking the icon"
          }
        }
      }
    },
    "Sistem ısınma durumunu ciddi olarak bildiriyor. Mac'in uyumasına izin verildi." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The system reports serious thermal pressure. The Mac is allowed to sleep again."
          }
        }
      }
    },
    "Süre seçerek başlatın ya da bir tetikleyici açın." : {
      "localizations" : {
        "en" : {
