    "Yüzde ve kalan süre macOS'un kendi güç kaynağı bilgisinden alınır; bu yüzden sistemin gösterdiğiyle aynıdır." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Percentage and time remaining come from macOS's own power source information, so they match what the system shows."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yüzde ve kalan süre macOS'un kendi güç kaynağı bilgisinden alınır; bu yüzden sistemin gösterdiğiyle aynıdır."
          }
        }
      }
    },
    "Yüzde ya da derece olarak sayı." : {
