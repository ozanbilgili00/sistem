        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indefinitely"
          }
        }
      }
    },
    "Sıcaklık 90 °C üstü: uyanık tutma durduruldu. 75 °C altına inince yeniden izin verilir." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Temperature above 90 °C: keeping awake was stopped. It is allowed again below 75 °C."
