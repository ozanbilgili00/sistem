    "NSBluetoothAlwaysUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bluetooth permission is needed to read the connection state of Bluetooth devices directly from the system. The device list and battery levels are shown even without it. Nothing is used for any other purpose or sent anywhere."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bluetooth cihazlarının bağlantı durumunu sistemden doğrudan okumak için Bluetooth izni gerekir. İzin verilmese de cihaz listesi ve pil seviyeleri gösterilir. Hiçbir bilgi başka bir amaçla kullanılmaz veya gönderilmez."
          }
        }
      }
    },
    "NSHumanReadableCopyright" : {
      "comment" : "Copyright (human-readable)",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : ""
          }
        }
      }
    },
    "NSLocationUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Location Services permission is needed to show the Wi-Fi network name. Location is never used for anything else and is never sent anywhere."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wi-Fi ağının adını göstermek için Konum Servisleri izni gerekir. Konum bilgisi başka hiçbir amaçla kullanılmaz ve hiçbir yere gönderilmez."
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Location Services permission is needed to show the Wi-Fi network name. Location is never used for anything else and is never sent anywhere."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wi-Fi ağının adını göstermek için Konum Servisleri izni gerekir. Konum bilgisi başka hiçbir amaçla kullanılmaz ve hiçbir yere gönderilmez."
          }
        }
      }
    },
    "NSLocalNetworkUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Servers module asks for this permission to reach the local network when it connects to a server you added or to an address on the local network. It is asked only when you add a server and connect, or run the network diagnostics tool; nothing is used for any other purpose."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sunucular modülü, eklediğiniz bir sunucuya ya da yerel ağdaki bir adrese bağlanırken yerel ağa erişmek için bu izni ister. İzin yalnızca siz bir sunucu ekleyip bağlandığınızda ya da ağ tanılama aracını çalıştırdığınızda sorulur; hiçbir bilgi başka bir amaçla kullanılmaz."
          }
        }
      }
    }
  },
  "version" : "1.0"
}